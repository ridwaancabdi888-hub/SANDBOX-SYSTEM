NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Get this from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Password used by `npm run seed:users` for the four demo staff accounts.
# Never hardcoded in the repo — those accounts exist on the deployed site.
SEED_PASSWORD=
